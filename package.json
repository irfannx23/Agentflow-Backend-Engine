{
  "name": "agentflow-backend-engine",
  "version": "0.1.0",
  "description": "Production-oriented event automation and RevOps intelligence engine powering AgentFlow.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "mx:start": "node dist/integrations/mx-service/mx-service.js",
    "start:events": "pnpm build && node --env-file-if-exists=.env dist/runtime/start-event-server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "pnpm build && node --test dist/testing/*.test.js",
    "validate:engine": "pnpm build && node --test dist/testing/registry.test.js dist/testing/workflow-validation.test.js dist/testing/production-engine.test.js",
    "validate:legacy": "node validators/validate_pre_crm_workflows.cjs"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "playwright": "^1.62.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@types/node": "^24.10.0",
    "eslint": "^9.38.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2"
  }
}
