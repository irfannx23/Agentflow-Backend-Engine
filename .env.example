# REQUIRED — backend event runtime
ENGINE_PORT=4310
# Server-only HMAC secret; use the same value as AgentFlow's variable.
AGENTFLOW_INTEGRATION_SECRET=
N8N_LEAD_QUALIFICATION_DISPATCH_URL=http://127.0.0.1:5678/webhook/agentflow-lead-qualification
N8N_REPLY_TO_DEAL_DISPATCH_URL=http://127.0.0.1:5678/webhook/agentflow-reply-to-deal
N8N_REVOPS_SIGNAL_DISPATCH_URL=http://127.0.0.1:5678/webhook/agentflow-revops-signals
N8N_DISPATCH_SECRET=

# REQUIRED — local n8n/MX/LiteLLM runtime
WEBHOOK_URL=http://localhost:5678
MX_SERVICE_PORT=9001
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_SECURE_COOKIE=false
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
LITELLM_PORT=4000

# REQUIRED — backend Supabase integration
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# REQUIRED — Lead Qualification AI provider
GEMINI_API_KEY=
GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models
GEMINI_MODEL=

# OPTIONAL — LiteLLM/DeepSeek; not used by the three canonical workflows
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek/deepseek-flash
LITELLM_MASTER_KEY=

# REQUIRED — verification and enrichment
EMAIL_VERIFY_API_KEY=
EMAIL_VERIFY_BASE_URL=https://api.emailable.com
ENRICH_API_KEY=
ENRICH_BASE_URL=https://api.apollo.io/api/v1/organizations/enrich

# REQUIRED — CRM and notifications
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_BASE_URL=https://api.hubapi.com
SLACK_WEBHOOK_URL=

# REQUIRED — email delivery
BREVO_API_KEY=
BREVO_BASE_URL=https://api.brevo.com
BREVO_SENDER_NAME=
BREVO_SENDER_EMAIL=
