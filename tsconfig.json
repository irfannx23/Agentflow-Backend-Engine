{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "exactOptionalPropertyTypes": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true
  },
  "include": [
    "actions/**/*.ts",
    "core/**/*.ts",
    "engines/**/*.ts",
    "integrations/**/*.ts",
    "registry/**/*.ts",
    "runtime/**/*.ts",
    "testing/*.test.ts",
    "triggers/**/*.ts",
    "validators/**/*.ts"
  ],
  "exclude": ["dist", "node_modules", "testing/legacy"]
}
