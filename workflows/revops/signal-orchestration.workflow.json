      "parameters": {
        "url": "={{ $env.SUPABASE_URL + '/rest/v1/rpc/generate_revops_signals' }}",
        "requestMethod": "POST",
        "jsonParameters": true,
        "headerParametersJson": "={{ JSON.stringify({ apikey: $env.SUPABASE_SERVICE_ROLE_KEY, Authorization: 'Bearer ' + $env.SUPABASE_SERVICE_ROLE_KEY }) }}",
        "bodyParametersJson": "={{ JSON.stringify({ p_source: 'n8n_revops_orchestration' }) }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      }
    },
    {
      "id": "require-scoped-account",
      "name": "RevOps: Dynamic Signal Scope",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        320,
        80
      ],
      "parameters": {
        "jsCode": "return [{ json: { scope: 'all_accounts', source: 'n8n_revops_orchestration' } }];\n"
      }
    },
    {
      "id": "split-signals",
      "name": "RevOps: Split Signals",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        80
      ],
      "parameters": {
        "jsCode": "/**\n * Split generated RevOps signals.\n * Handles PostgREST's normal array response and emits one item per pending signal.\n * If nothing is actionable, emit one explicit no-op item so manual/scheduled runs\n * finish clearly instead of looking like a broken empty branch.\n */\n\nconst rawItems = typeof $input.all === 'function'\n  ? $input.all().map((item) => item.json)\n  : [$input.first()?.json];\nconst payload = rawItems.flatMap((raw) => Array.isArray(raw) ? raw : [raw]);\nconst currentProductSignalTypes = new Set([\n  'PQL_REACHED',\n  'UPGRADE_INTENT',\n  'SIGNIFICANT_USAGE_GROWTH',\n  'SUBSCRIPTION_ACTIVATED',\n  'ALLOWANCE_PRESSURE',\n  'BUDGET_PRESSURE',\n]);\nconst signals = payload.filter((row) =>\n  row &&\n  row.signal_key &&\n  row.status === 'pending' &&\n  row.account_id &&\n  currentProductSignalTypes.has(row.signal_type)\n);\n\nif (!signals.length) {\n  return [{ json: { actionable: false, status: 'no_actionable_signals', signal_count: 0 } }];\n}\n\nreturn signals.map((signal) => ({ json: { ...signal, actionable: true } }));\n"
      }
    },
    {
      "id": "has-actionable-signal",
      "name": "RevOps: Has Actionable Signal?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1120,
        80
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "cond-has-actionable-signal",
              "leftValue": "={{ $json.actionable }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      }
    },
