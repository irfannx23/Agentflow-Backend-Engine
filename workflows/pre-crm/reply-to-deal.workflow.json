{
  "id": "reply-to-deal",
  "name": "Reply-to-Deal",
  "nodes": [
    {
      "id": "backend-event-trigger",
      "name": "Reply Cron: Backend Event Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        180
      ],
      "webhookId": "agentflow-reply-to-deal-webhook",
      "parameters": {
        "httpMethod": "POST",
        "path": "agentflow-reply-to-deal",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "sched-reply-cron",
      "name": "Reply Cron: Every 15 min",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      }
    },
    {
      "id": "validate-backend-dispatch",
      "name": "Reply Cron: Validate Backend Dispatch Secret",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        180
      ],
      "parameters": {
        "jsCode": "const expected = String($env.N8N_DISPATCH_SECRET || '');\nconst headers = $json.headers || {};\nconst supplied = String(headers['x-agentflow-dispatch-secret'] || headers['X-AgentFlow-Dispatch-Secret'] || '');\nreturn [{ json: { ...$json, dispatch_authorized: Boolean(expected && supplied && supplied === expected) } }];\n"
      }
    },
    {
      "id": "if-dispatch-authorized",
      "name": "Reply Cron: Backend Dispatch Authorized?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        330,
        180
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "cond-dispatch-authorized",
              "leftValue": "={{ $json.dispatch_authorized }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "respond-dispatch-accepted",
      "name": "Reply Cron: Respond Accepted",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        440,
        180
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { status: 'accepted' } }}",
        "options": {
          "responseCode": 202
        }
      }
    },
    {
      "id": "respond-dispatch-unauthorized",
      "name": "Reply Cron: Respond Unauthorized",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        440,
        300
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { error: 'unauthorized' } }}",
        "options": {
          "responseCode": 401
        }
      }
    },
    {
      "id": "rpc-get-replied",
      "name": "Reply Cron: Get Replied",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "stopWorkflow",
      "parameters": {
        "url": "={{ $env.SUPABASE_URL + '/rest/v1/rpc/get_replied_outreach' }}",
        "requestMethod": "POST",
        "jsonParameters": true,
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        },
        "headerParametersJson": "={{ JSON.stringify({ apikey: $env.SUPABASE_SERVICE_ROLE_KEY, Authorization: 'Bearer ' + $env.SUPABASE_SERVICE_ROLE_KEY }) }}",
        "bodyParametersJson": "={{ JSON.stringify({ p_limit: 10 }) }}"
      }
    },
    {
      "id": "code-split-replied",
      "name": "Reply Cron: Split Rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "jsCode": "const raw = $input.first()?.json;\nconst payload = Array.isArray(raw) ? (raw[0] || {}) : (raw || {});\nconst rows = Array.isArray(payload.rows) ? payload.rows : [];\nif (!rows.length) return [];\nreturn rows.map((row) => ({ json: row }));\n"
      }
    },
    {
      "id": "if-existing-deal",
      "name": "Reply Cron: Existing Deal?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "cond-existing-deal",
              "leftValue": "={{ $json.deal_id }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "hs-upsert-contact",
      "name": "Reply Cron: Upsert Contact",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 2,
      "position": [
        1100,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "stopWorkflow",
      "parameters": {
        "url": "={{ $env.HUBSPOT_BASE_URL + '/crm/v3/objects/contacts/batch/upsert' }}",
        "requestMethod": "POST",
        "jsonParameters": true,
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        },
        "headerParametersJson": "={{ JSON.stringify({ Authorization: 'Bearer ' + $env.HUBSPOT_ACCESS_TOKEN }) }}",
        "bodyParametersJson": "={{ JSON.stringify({ inputs: [{ id: $json.email, idProperty: 'email', properties: { email: $json.email, company: $json.company_name || '' } }] }) }}"
      }
    },
    {
      "id": "hs-create-deal",
      "name": "Reply Cron: Create Deal",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 2,
      "position": [
        1320,
        0
      ],
      "retryOnFail": false,
      "maxTries": 1,
      "waitBetweenTries": 0,
      "onError": "stopWorkflow",
      "parameters": {
        "url": "={{ $env.HUBSPOT_BASE_URL + '/crm/v3/objects/deals' }}",
        "requestMethod": "POST",
        "jsonParameters": true,
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        },
        "headerParametersJson": "={{ JSON.stringify({ Authorization: 'Bearer ' + $env.HUBSPOT_ACCESS_TOKEN }) }}",
        "bodyParametersJson": "={{ JSON.stringify({ properties: { dealname: 'Outbound Reply \u2014 ' + ($('Reply Cron: Split Rows').item.json.company_name || $('Reply Cron: Split Rows').item.json.email), amount: '0', pipeline: 'default', dealstage: 'appointmentscheduled' }, associations: [{ types: [{ associationCategory: 'HUBSPOT_DEFINED', associationTypeId: 3 }], to: { id: $json.results[0].id } }] }) }}"
      }
    },
    {
      "id": "rpc-mark-deal",
      "name": "Reply Cron: Mark Deal Created",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 2,
      "position": [
        1540,
        0
      ],
      "retryOnFail": false,
      "maxTries": 1,
      "waitBetweenTries": 0,
      "onError": "stopWorkflow",
      "parameters": {
        "url": "={{ $env.SUPABASE_URL + '/rest/v1/rpc/mark_deal_created' }}",
        "requestMethod": "POST",
        "jsonParameters": true,
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        },
        "headerParametersJson": "={{ JSON.stringify({ apikey: $env.SUPABASE_SERVICE_ROLE_KEY, Authorization: 'Bearer ' + $env.SUPABASE_SERVICE_ROLE_KEY }) }}",
        "bodyParametersJson": "={{ JSON.stringify({ p_id: $('Reply Cron: Split Rows').item.json.id, p_deal_id: $json.id }) }}"
      }
    },
    {
      "id": "rpc-evaluate-deal",
      "name": "Reply Cron: Evaluate Qualification",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 2,
      "position": [
        1760,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "stopWorkflow",
      "parameters": {
        "url": "={{ $env.SUPABASE_URL + '/rest/v1/rpc/evaluate_lead_qualification' }}",
        "requestMethod": "POST",
        "jsonParameters": true,
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        },
        "headerParametersJson": "={{ JSON.stringify({ apikey: $env.SUPABASE_SERVICE_ROLE_KEY, Authorization: 'Bearer ' + $env.SUPABASE_SERVICE_ROLE_KEY }) }}",
        "bodyParametersJson": "={{ JSON.stringify({ p_lead_id: $('Reply Cron: Split Rows').item.json.lead_id, p_evaluation_type: 'deal_created', p_source_runtime: 'reply_deal_workflow' }) }}"
      }
    },
    {
      "id": "rpc-route-deal",
      "name": "Reply Cron: Route Lead to Sales",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 2,
      "position": [
        1980,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "stopWorkflow",
      "parameters": {
        "url": "={{ $env.SUPABASE_URL + '/rest/v1/rpc/route_lead_to_sales' }}",
        "requestMethod": "POST",
        "jsonParameters": true,
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        },
        "headerParametersJson": "={{ JSON.stringify({ apikey: $env.SUPABASE_SERVICE_ROLE_KEY, Authorization: 'Bearer ' + $env.SUPABASE_SERVICE_ROLE_KEY }) }}",
        "bodyParametersJson": "={{ JSON.stringify({ p_lead_id: $('Reply Cron: Split Rows').item.json.lead_id, p_trigger: 'reply_deal_handoff', p_force_reassign: false }) }}"
      }
    },
    {
      "id": "rpc-sync-deal-crm",
      "name": "Reply Cron: Sales Sync CRM",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 2,
      "position": [
        2200,
        0
      ],
      "retryOnFail": false,
      "maxTries": 1,
      "waitBetweenTries": 0,
      "onError": "stopWorkflow",
      "parameters": {
        "url": "={{ $env.SUPABASE_URL + '/rest/v1/rpc/update_sales_assignment_sync' }}",
        "requestMethod": "POST",
        "jsonParameters": true,
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        },
        "headerParametersJson": "={{ JSON.stringify({ apikey: $env.SUPABASE_SERVICE_ROLE_KEY, Authorization: 'Bearer ' + $env.SUPABASE_SERVICE_ROLE_KEY }) }}",
        "bodyParametersJson": "={{ JSON.stringify({ p_lead_id: $('Reply Cron: Split Rows').item.json.lead_id, p_crm_sync_status: 'synced', p_reason: 'reply_deal_crm_sync' }) }}"
      }
    },
    {
      "id": "slack-reply-deal",
      "name": "Reply Cron: Slack Alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2420,
        0
      ],
      "retryOnFail": false,
      "maxTries": 1,
      "waitBetweenTries": 0,
      "onError": "stopWorkflow",
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SLACK_WEBHOOK_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: '\ud83e\udd1d REPLY \u2192 DEAL: ' + ($('Reply Cron: Split Rows').item.json.company_name || 'Unknown') + ' (' + $('Reply Cron: Split Rows').item.json.email + ') \u2014 deal ' + ($('Reply Cron: Split Rows').item.json.deal_id || $('Reply Cron: Create Deal').item.json.id) + '\\nOwner: ' + (($('Reply Cron: Route Lead to Sales').item.json.current_owner_type || 'unassigned').toUpperCase()) + ' \u00b7 Priority: ' + ($('Reply Cron: Route Lead to Sales').item.json.priority_tier || 'low') }) }}",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "responseFormat": "text"
            }
          }
        }
      }
    },
    {
      "id": "rpc-sync-deal-slack",
      "name": "Reply Cron: Sales Sync Slack",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 2,
      "position": [
        2640,
        0
      ],
      "retryOnFail": false,
      "maxTries": 1,
      "waitBetweenTries": 0,
      "onError": "stopWorkflow",
      "parameters": {
        "url": "={{ $env.SUPABASE_URL + '/rest/v1/rpc/update_sales_assignment_sync' }}",
        "requestMethod": "POST",
        "jsonParameters": true,
        "options": {
          "timeout": 30000,
          "response": {
