              "responseFormat": "json"
            }
          }
        },
        "headerParametersJson": "={{ JSON.stringify({ apikey: $env.SUPABASE_SERVICE_ROLE_KEY, Authorization: 'Bearer ' + $env.SUPABASE_SERVICE_ROLE_KEY }) }}",
        "bodyParametersJson": "={{ JSON.stringify({ p_lead_id: $('Reply Cron: Split Rows').item.json.lead_id, p_slack_sync_status: 'synced', p_reason: 'reply_deal_sales_alert' }) }}"
